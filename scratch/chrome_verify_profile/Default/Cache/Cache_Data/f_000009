}

function focusLeak() {
  const currentId = mapState.selectedSensorId || 'center';
  const sensor    = MAP_CONFIG.SENSORS.find(s => s.id === currentId) || MAP_CONFIG.SENSORS[0];
  mapState.map?.flyTo([sensor.lat, sensor.lng], MAP_CONFIG.ZOOM_ALERT, { duration: 1.2 });
