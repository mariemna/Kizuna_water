/** Applique l'état de la vanne à tous les éléments visuels. */
function applyValveUI(open, etatAlerte, typeAlerte, lastDebitEvite, eauEconomisee, alerteDepuis) {
  const jp = window.KizunaI18n?.getLanguage() === 'jp';
  set('valveValue', jp ? (open ? '開' : '閉') : (open ? 'Open' : 'Closed'));

  const foot = $('valveFoot');
  if (foot) {
    foot.textContent = jp ? (open ? '● 正常稼働' : '● 流量停止') : (open ? '● Normal operation' : '● Flow interrupted');
    foot.className   = open ? 'stat-positive' : 'stat-danger';
  }

  const typeLabel = formatAlertType(typeAlerte);

  if (etatAlerte === 'FERMEE') {
    const timeSince = formatTimeSince(alerteDepuis);
    set('valveState', jp ? '漏水確認 — バルブ自動閉鎖' : 'Leak confirmed – valve closed automatically');
    set('valveDescription', typeLabel
      ? (timeSince ? `${typeLabel} · Closed ${timeSince}.` : `${typeLabel} · Valve closed automatically.`)
      : 'Water circulation is currently interrupted.');
  } else if (etatAlerte === 'ALERTE') {
    set('valveState', jp ? '異常検知 — バルブ開・監視中' : 'Anomaly detected – valve open, monitoring');
    set('valveDescription', typeLabel
      ? `${typeLabel} · Active monitoring in progress.`
      : 'Water is flowing under surveillance.');
  } else {
    set('valveState', jp ? (open ? 'バルブ開' : 'バルブ閉') : (open ? 'Valve open' : 'Valve closed'));
    set('valveDescription', open
      ? (jp ? '給水ネットワークで水が正常に流れています。' : "Water is flowing normally through the network.")
      : (jp ? '現在、水の循環が停止しています。' : "Water circulation is currently interrupted."));
  }

  // Water saved badge
  const badgeEl = $('waterSavedBadge');
  if (badgeEl) {
    const savedNum = Number(eauEconomisee || 0).toFixed(1);
    const eviteNum = Number(lastDebitEvite || 0).toFixed(1);
    if (!open && lastDebitEvite > 0) {
      badgeEl.textContent = `💧 ${savedNum} L of water saved (${eviteNum} L/min being saved)`;
    } else {
      badgeEl.textContent = `💧 ${savedNum} L of water saved`;
    }
  }

  $('valveVisual')?.classList.toggle('closed', !open);
  set('deviceValveStatus', open ? 'Online' : 'Closed');

  if ($('closeValveBtn')) $('closeValveBtn').disabled = !open;
  if ($('openValveBtn'))  $('openValveBtn').disabled  =  open;
}

/** Met à jour la bannière d'alerte, les KPI et le panneau des alertes récentes. */
function applyAlertUI(etatAlerte, typeAlerte, debit, alerteDepuis, alertesLog, stats) {
  const banner = $('alertBanner');
  const typeLabel = formatAlertType(typeAlerte);

  if (banner) {
    banner.classList.remove('hidden-alert', 'state-normal', 'state-alerte', 'state-fermee');

    if (etatAlerte === 'FERMEE') {
      banner.classList.add('state-fermee');
      set('bannerTitle', 'Leak confirmed – valve closed automatically');
      const timeSince = formatTimeSince(alerteDepuis);
      set('bannerText', typeLabel
        ? (timeSince ? `${typeLabel} · Active since ${timeSince}.` : `${typeLabel} · Automatic emergency shutoff.`)
        : 'Water network closed automatically.');
      set('bannerTime', 'CRITICAL');
    } else if (etatAlerte === 'ALERTE') {
      banner.classList.add('state-alerte');
      set('bannerTitle', 'Anomaly detected – valve open, monitoring');
      set('bannerText', typeLabel
        ? `${typeLabel} · Current flow: ${debit} L/min.`
        : `Unusual flow detected: ${debit} L/min.`);
      set('bannerTime', 'MONITORING');
    } else {
      banner.classList.add('hidden-alert', 'state-normal');
      set('bannerTitle', 'No anomaly detected');
      set('bannerText', 'Flow is within the normal range.');
      set('bannerTime', 'JUST NOW');
    }
  }

  // Nav alert count & KPI card
  const isProblem = etatAlerte === 'FERMEE' || etatAlerte === 'ALERTE';
  set('navAlertCount', isProblem ? '1' : '0');

  const alertCount = (stats && stats.alertes_aujourdhui !== undefined)
    ? String(stats.alertes_aujourdhui).padStart(2, '0')
    : (isProblem ? '01' : '00');
  set('alertValue', alertCount);

  const alertFoot = $('alertFoot');
  if (alertFoot) {
    if (etatAlerte === 'FERMEE') {
      alertFoot.textContent = '● Emergency shutoff active';
      alertFoot.className = 'stat-danger';
    } else if (etatAlerte === 'ALERTE') {
      alertFoot.textContent = '● Anomaly under surveillance';
      alertFoot.className = 'stat-warning';
    } else {
      alertFoot.textContent = '● Monitoring active · Normal';
      alertFoot.className = 'stat-positive';
    }
  }

  // Panneau Recent Alerts (alimenté depuis alertes_log)
  updateRecentAlertsPanel(alertesLog, etatAlerte, typeAlerte, debit);
}

function updateRecentAlertsPanel(alertesLog, currentEtat, currentType, currentDebit) {
  const container = $('alertsList');
  if (!container) return;

  if (Array.isArray(alertesLog) && alertesLog.length > 0) {
    const itemsHtml = alertesLog.slice(0, 5).map(item => {
      const typeText = formatAlertType(item.type) || item.type || 'Alert';
      const debitVal = parseFloat(item.debit || 0).toFixed(1);
      const timeStr  = item.created_at || 'Today';

      if (item.etat === 'FERMEE') {
        return `<div class="alert-item">
          <span class="alert-type">!</span>
          <div>
            <b>${typeText} — Valve Closed</b>
            <p>Flow: ${debitVal} L/min — Automatic safety closure</p>
            <small>${timeStr}</small>
          </div>
          <span class="severity">CRITICAL</span>
        </div>`;
      } else if (item.etat === 'ALERTE') {
        return `<div class="alert-item">
          <span class="alert-type warning">!</span>
          <div>
            <b>${typeText} — Anomaly</b>
            <p>Flow: ${debitVal} L/min — Under monitoring</p>
            <small>${timeStr}</small>
          </div>
          <span class="severity warning-severity">WARNING</span>
        </div>`;
      } else {
        return `<div class="alert-item muted-alert">
          <span class="alert-type normal">✓</span>
          <div>
            <b>Valve Reopened — Back to normal</b>
            <p>Flow: ${debitVal} L/min — Operational range restored</p>
            <small>${timeStr}</small>
          </div>
          <span class="severity normal-severity">RESOLVED</span>
        </div>`;
      }
    }).join('');

    container.innerHTML = itemsHtml;
  } else {
    if (currentEtat === 'FERMEE') {
      container.innerHTML = `<div class="alert-item">
        <span class="alert-type">!</span>
        <div>
          <b>${formatAlertType(currentType) || 'Leak confirmed'} — Valve Closed</b>
          <p>Flow: ${currentDebit} L/min — Automatic safety closure</p>
          <small>Today · Active</small>
        </div>
        <span class="severity">CRITICAL</span>
      </div>`;
    } else if (currentEtat === 'ALERTE') {
      container.innerHTML = `<div class="alert-item">
        <span class="alert-type warning">!</span>
        <div>
          <b>${formatAlertType(currentType) || 'Anomaly detected'} — Under monitoring</b>
          <p>Flow: ${currentDebit} L/min — Surveillance in progress</p>
          <small>Today · Active</small>
        </div>
        <span class="severity warning-severity">WARNING</span>
      </div>`;
    } else {
      container.innerHTML = `<div class="alert-item muted-alert">
        <span class="alert-type info">i</span>
        <div>
          <b>Monitoring active</b>
          <p>Sensors are successfully transmitting measurements</p>
          <small>Today · Continuous</small>
        </div>
        <span class="severity info-severity">INFO</span>
      </div>`;
    }
  }
}

/** Synchronise le bouton Mode Nuit avec l'état BDD. */
function applyNightUI(isNight) {
  const btn = $('nightModeBtn');
  if (!btn) return;
  const jp = window.KizunaI18n?.getLanguage() === 'jp';
  btn.textContent = jp
    ? (isNight ? '🌙 ナイトモード：オン' : '☀️ ナイトモード：オフ')
    : (isNight ? '🌙 Night Mode: ON' : '☀️ Night Mode: OFF');
  btn.classList.toggle('night-active', isNight);
}

/** Met à jour les 4 cartes KPI depuis les données réelles. */
function applyStats(data) {
  const mesures  = data.mesures || [];
  const derniere = mesures.length ? mesures[mesures.length - 1] : null;
  if (!derniere) return;

  const debit         = parseFloat(derniere.debit_eau);
  const debitEvite    = parseFloat(derniere.debit_evite || 0);
  const isOpen        = data.statut_vanne === 'OUVERTE';
  const etatAlerte    = data.etat_alerte || 'NORMAL';
  const typeAlerte    = data.type_alerte || null;
  const alerteDepuis  = data.alerte_depuis || null;
  const eauEconomisee = (data.stats && data.stats.eau_economisee !== undefined) ? Number(data.stats.eau_economisee) : 0;
  const consoJour     = (data.stats && data.stats.consommation_jour !== undefined) ? Number(data.stats.consommation_jour) : 0;

  // Débit actuel
  set('flowValue', debit.toFixed(1));
  htm('chartCurrent', `${debit.toFixed(1)} <small>L/min</small>`);

  // Consommation réelle aujourd'hui (sans floor 200 L)
  set('consumptionValue', consoJour.toFixed(1));

  // Eau économisée KPI
  if (!isOpen && debitEvite > 0) {
    set('waterSavedMetric', `💧 ${eauEconomisee.toFixed(1)} L (${debitEvite.toFixed(1)} L/min saved)`);
  } else {
    set('waterSavedMetric', `💧 ${eauEconomisee.toFixed(1)} L`);
  }

  applyValveUI(isOpen, etatAlerte, typeAlerte, debitEvite, eauEconomisee, alerteDepuis);
  applyAlertUI(etatAlerte, typeAlerte, debit.toFixed(1), alerteDepuis, data.alertes_log || [], data.stats || {});
  applyNightUI(data.mode_nuit);

  // Détection d'un changement d'état de vanne externe (ex: fermeture automatique)
  if (appState.lastValveStatus && appState.lastValveStatus !== data.statut_vanne) {
    if (data.statut_vanne === 'FERMEE') {
      addActivity('Valve closed automatically', 'Anti-leak protection activated', 'warning');
    } else if (data.statut_vanne === 'OUVERTE') {
      addActivity('Valve reopened', 'Normal network operation restored', 'success');
    }
  }
  appState.lastValveStatus = data.statut_vanne;
}

