<!-- ── Modal Export ──────────────────────────────────────── -->
<div id="exportModal" class="kz-modal-backdrop" style="display:none;" role="dialog" aria-modal="true" aria-labelledby="exportModalTitle">
  <div class="kz-modal-box">
    <div class="kz-modal-header">
      <div style="display:flex; align-items:center; gap:10px;">
        <div class="kz-modal-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        </div>
        <div>
          <h3 id="exportModalTitle" class="kz-modal-title">Export Data &amp; Reports</h3>
          <p class="kz-modal-subtitle">Download records or generate official intervention reports</p>
        </div>
      </div>
      <button type="button" class="kz-modal-close" onclick="closeExportModal()" aria-label="Close modal">&times;</button>
    </div>

    <form id="exportForm" onsubmit="handleExportSubmit(event)">
      <!-- Period Selection -->
      <div class="kz-export-section">
        <label class="kz-export-label">Period</label>
        <div class="kz-period-options">
          <label class="kz-radio-pill">
            <input type="radio" name="exportPeriod" value="today" checked onchange="handlePeriodChange()">
            <span>Today</span>
          </label>
          <label class="kz-radio-pill">
            <input type="radio" name="exportPeriod" value="24h" onchange="handlePeriodChange()">
            <span>Last 24 h</span>
          </label>
          <label class="kz-radio-pill">
            <input type="radio" name="exportPeriod" value="7d" onchange="handlePeriodChange()">
            <span>Last 7 days</span>
          </label>
          <label class="kz-radio-pill">
            <input type="radio" name="exportPeriod" value="custom" onchange="handlePeriodChange()">
            <span>Custom</span>
          </label>
        </div>

        <!-- Custom Date Range -->
        <div id="customDateRow" class="kz-custom-dates" style="display:none;">
          <div class="kz-date-field">
            <label for="exportDateDu">From</label>
            <input type="date" id="exportDateDu">
          </div>
          <div class="kz-date-field">
            <label for="exportDateAu">To</label>
            <input type="date" id="exportDateAu">
          </div>
        </div>
      </div>

      <!-- Format Selection -->
      <div class="kz-export-section" style="margin-top:16px;">
        <label class="kz-export-label">Format</label>
        <div class="kz-format-options">
          <label class="kz-format-card">
            <input type="radio" name="exportFormat" value="mesures" checked>
            <div class="kz-format-content">
              <div class="kz-format-title">
                <span class="kz-badge-csv">CSV</span> CSV – Measurements
              </div>
              <div class="kz-format-desc">Raw flow readings (L/min), avoided flow, and valve state</div>
            </div>
          </label>

          <label class="kz-format-card">
            <input type="radio" name="exportFormat" value="alertes">
            <div class="kz-format-content">
              <div class="kz-format-title">
                <span class="kz-badge-csv">CSV</span> CSV – Alerts
              </div>
              <div class="kz-format-desc">Alert state transitions, leak types, and flow during incident</div>
            </div>
          </label>

          <label class="kz-format-card">
            <input type="radio" name="exportFormat" value="notifications">
            <div class="kz-format-content">
              <div class="kz-format-title">
                <span class="kz-badge-csv">CSV</span> CSV – Notifications
              </div>
              <div class="kz-format-desc">Emergency dispatch logs (SMS / Telegram) with masked numbers</div>
            </div>
          </label>

          <label class="kz-format-card kz-format-pdf">
            <input type="radio" name="exportFormat" value="pdf">
            <div class="kz-format-content">
              <div class="kz-format-title">
                <span class="kz-badge-pdf">PDF</span> PDF report (print)
              </div>
              <div class="kz-format-desc">Printable A4 intervention report with KPIs, chart, rules &amp; signature</div>
            </div>
          </label>
        </div>
      </div>

      <!-- Actions -->
      <div class="kz-modal-footer">
        <button type="button" class="outline-btn" onclick="closeExportModal()">Cancel</button>
        <button type="submit" class="btn btn-primary" id="btnExecuteExport" style="display:inline-flex; align-items:center; gap:6px;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          Export
        </button>
      </div>
    </form>
  </div>
</div>

<div class="theme-switcher" role="radiogroup" aria-label="Theme switcher">
  <button type="button" data-theme-value="light" aria-label="Light theme" title="Light theme">☀️ <span>Light</span></button>
  <button type="button" data-theme-value="dark" aria-label="Dark theme" title="Dark theme">🌙 <span>Dark</span></button>
  <button type="button" data-theme-value="comfort" aria-label="Eye comfort theme" title="Eye comfort theme">👁️ <span>Comfort</span></button>
</div>
<script src="assets/theme.js?v=20261121"></script>
</body>
</html>
