function applyChart(mesures, seuilActif) {
  if (!appState.chart || !mesures) return;

  const seuil  = parseFloat(seuilActif) || 5.0;
  const labels = [];
  const values = [];

  mesures.forEach(m => {
    const ts = new Date(m.timestamp.replace(' ', 'T'));
    labels.push(ts.toLocaleTimeString('en-US', {
      hour: '2-digit', minute: '2-digit', second: '2-digit',
    }));
    values.push(parseFloat(m.debit_eau));
  });

  appState.chart.data.labels             = labels;
  appState.chart.data.datasets[0].data   = values;
  appState.chart.data.datasets[1].data   = values.map(() => seuil);
  appState.chart.update('none');
}

